# GRC Web launcher. Runs with the Python that has GNU Radio installed. If that
# Python lacks aiohttp, a virtual environment is created on top of it (its
# packages stay visible) and aiohttp is installed there.
#
#   ./grc-web user add <name> --admin     create a user
#   ./grc-web serve                        start on http://127.0.0.1:8410
#   ./grc-web --help
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VENV="$HERE/.venv"

find_python() {
    local candidate
    for candidate in "${GRCWEB_PYTHON:-}" /usr/bin/python3 /usr/local/bin/python3 python3; do
        [ -n "$candidate" ] || continue
        if command -v "$candidate" >/dev/null 2>&1 &&
           "$candidate" -c 'import gnuradio.grc.core.platform' >/dev/null 2>&1; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

if [ -x "$VENV/bin/python" ]; then
    PYTHON="$VENV/bin/python"
else
    PYTHON="$(find_python)" || {
        echo "No Python with GNU Radio Companion found." >&2
        echo "Install GNU Radio 3.10 (with GRC), or point GRCWEB_PYTHON to its python3." >&2
        exit 1
    }
    # nothing to install when the distribution provides aiohttp (python3-aiohttp)
    if ! "$PYTHON" -c 'import aiohttp' >/dev/null 2>&1; then
        echo "Creating $VENV with $PYTHON ..." >&2
        "$PYTHON" -m venv --system-site-packages "$VENV" || {
            rm -rf "$VENV"
            echo "Could not create a virtual environment to install aiohttp." >&2
            echo "Debian/Ubuntu: sudo apt install python3-aiohttp   (or python3-venv)" >&2
            exit 1
        }
        PYTHON="$VENV/bin/python"
    fi
fi
if ! "$PYTHON" -c 'import aiohttp' >/dev/null 2>&1; then
    "$PYTHON" -m pip install --quiet --disable-pip-version-check -r "$HERE/requirements.txt"
fi

export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m grcweb "$@"
